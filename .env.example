# ==============================================================================
# CookMyCv Environment Variables Template
# ==============================================================================
# Copy this file to .env or .env.local and populate with your own credentials.
# Do NOT commit actual secrets to source control.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/cookmycv?sslmode=require

# Authentication (Neon Managed Better Auth & JWKS)
BETTER_AUTH_SECRET=change-this-to-a-secure-random-string-at-least-32-chars-long
BETTER_AUTH_URL=https://ep-curly-dawn-bebv64a0.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=https://ep-curly-dawn-bebv64a0.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-curly-dawn-bebv64a0.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=change-this-to-a-secure-random-string-at-least-32-chars-long
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-curly-dawn-bebv64a0.neonauth.c-9.us-east-2.aws.neon.tech/neondb/auth

# Device Security (One-Device-One-Account Cookie Signing)
DEVICE_TOKEN_SECRET=change-this-to-a-secure-random-device-signing-secret

# AI Provider Configuration (Google Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSy_placeholder_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash # Options: gemini-3.8-flash, gemini-flash-latest, gemini-flash-lite-latest
OPENAI_API_KEY=

# Verify.ET Payment Integration (ETB)
VERIFY_ET_API_KEY=placeholder-verify-et-api-key
VERIFY_ET_WEBHOOK_SECRET=placeholder-verify-et-webhook-secret
VERIFY_ET_BASE_URL=https://verify.et/api

# Polar.sh Payment Integration (USD)
POLAR_SERVER=sandbox # Options: sandbox, production
POLAR_ACCESS_TOKEN=polar_at_placeholder_access_token
POLAR_WEBHOOK_SECRET=whsec_placeholder_webhook_secret
POLAR_PRODUCT_ID_PRO_MONTHLY=placeholder_prod_id_pro_monthly
POLAR_PRODUCT_ID_PRO_PLUS_MONTHLY=placeholder_prod_id_pro_plus_monthly
POLAR_PRODUCT_ID_PRO_PLUS_YEARLY=placeholder_prod_id_pro_plus_yearly
POLAR_PRODUCT_ID_EXECUTIVE_UNLIMITED=placeholder_prod_id_executive_unlimited

# Private Object Storage (S3-compatible / Private Bucket for CVs & Reports)
STORAGE_ENDPOINT=
STORAGE_BUCKET=cookmycv-private-documents
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=placeholder-storage-access-key
STORAGE_SECRET_ACCESS_KEY=placeholder-storage-secret-key

# Solana Web3 Integration (Devnet)
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_PROGRAM_ID=FXboyZZ2em2FqXrcr4Uz5nfrHHQ4K1NaJ6kP9VMBJ3Yt
NEXT_PUBLIC_SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
COOV_ORACLE_PRIVATE_KEY=[0,0,0]
